-- Camera Lock-On System

-- LocalScript should be placed in StarterPlayerScripts

local Players = game:GetService("Players")

local RunService = game:GetService("RunService")

local UserInputService = game:GetService("UserInputService")

local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local camera = Workspace.CurrentCamera

local mouse = player:GetMouse()

-- Configuration

local LOCK_ON_RANGE = 100 -- Studs

local LOCK_SMOOTHNESS = 0.25 -- Lower = smoother, higher = snappier

local MAX_ANGLE = 60 -- Maximum angle from camera forward to consider for lock-on

-- State management

local isLockedOn = false

local currentTarget = nil

local lockOnButtonDown = false

-- Create GUI for mobile

local function createMobileUI()

	if UserInputService.TouchEnabled then		local gui = Instance.new("ScreenGui")

		gui.Name = "LockOnUI"

		gui.Parent = player.PlayerGui

		

		local button = Instance.new("TextButton")

		button.Name = "LockOnButton"

		button.Text = "🔒\nLock On"

		button.TextScaled = true

		button.Size = UDim2.new(0, 100, 0, 100)

		button.Position = UDim2.new(1, -120, 1, -120)

		button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

		button.BackgroundTransparency = 0.3

		button.TextColor3 = Color3.fromRGB(255, 255, 255)

		button.BorderSizePixel = 0

		button.Parent = gui

		

		-- Button events

		button.Activated:Connect(function()

			isLockedOn = not isLockedOn

			if not isLockedOn then

				currentTarget = nil

			end

			updateButtonAppearance(button)

		end)

		

		-- Update button appearance based on state

		function updateButtonAppearance(btn)

			if isLockedOn then

				btn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)

				btn.Text = "🔒\nLocked"

			else

				btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

				btn.Text = "🔒\nLock On"

			end

		end

	end

end

-- Check if a target is visible (not behind walls)

local function isTargetVisible(targetHead)

	if not targetHead then return false end

	

	local cameraPos = camera.CFrame.Position

	local targetPos = targetHead.Position

	

	-- Raycast to check for obstructions

	local raycastParams = RaycastParams.new()

	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

	raycastParams.FilterDescendantsInstances = {player.Character, targetHead.Parent}

	raycastParams.IgnoreWater = true

	

	local raycastResult = Workspace:Raycast(cameraPos, targetPos - cameraPos, raycastParams)

	

	-- If we hit nothing, or we hit the target or something in the target's model, it's visible

	if not raycastResult then

		return true

	end

	

	-- Check if what we hit is part of the target character

	local hitPart = raycastResult.Instance

	if hitPart and hitPart:IsDescendantOf(targetHead.Parent) then

		return true

	end

	

	return false

end

-- Find the best target to lock onto

local function findBestTarget()

	if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then

		return nil

	end

	

	local playerPosition = player.Character.HumanoidRootPart.Position

	local bestTarget = nil

	local bestScore = 0

	

	for _, otherPlayer in ipairs(Players:GetPlayers()) do

		if otherPlayer ~= player and otherPlayer.Character then

			local humanoid = otherPlayer.Character:FindFirstChild("Humanoid")

			local head = otherPlayer.Character:FindFirstChild("Head")

			local root = otherPlayer.Character:FindFirstChild("HumanoidRootPart")

			

			if humanoid and humanoid.Health > 0 and head and root then

				-- Check distance

				local distance = (root.Position - playerPosition).Magnitude

				if distance <= LOCK_ON_RANGE then

					-- Check visibility

					if isTargetVisible(head) then

						-- Check if target is within camera view angle

						local cameraDirection = camera.CFrame.LookVector

						local toTarget = (head.Position - camera.CFrame.Position).Unit

						local angle = math.deg(math.acos(cameraDirection:Dot(toTarget)))

						

						if angle <= MAX_ANGLE then

							-- Calculate score (closer targets and more centered targets score higher)

							local distanceScore = (LOCK_ON_RANGE - distance) / LOCK_ON_RANGE

							local angleScore = (MAX_ANGLE - angle) / MAX_ANGLE

							local totalScore = distanceScore * 0.6 + angleScore * 0.4

							

							if totalScore > bestScore then

								bestScore = totalScore

								bestTarget = head

							end

						end

					end

				end

			end

		end

	end

	

	return bestTarget

end

-- Update camera lock

local function updateCameraLock()

	if not isLockedOn then return end

	

	-- If we have no current target, try to find one

	if not currentTarget or not currentTarget.Parent then

		currentTarget = findBestTarget()

		if not currentTarget then return end

	end

	

	-- Verify current target is still valid

	local targetCharacter = currentTarget.Parent

	local humanoid = targetCharacter:FindFirstChild("Humanoid")

	

	if not humanoid or humanoid.Health <= 0 then

		currentTarget = findBestTarget()

		if not currentTarget then return end

		targetCharacter = currentTarget.Parent

		humanoid = targetCharacter:FindFirstChild("Humanoid")

	end

	

	if not humanoid or humanoid.Health <= 0 then

		currentTarget = nil

		return

	end

	

	-- Check if current target is still visible and in range

	local playerPosition = player.Character and player.Character:FindFirstChild("HumanoidRootPart") 

		and player.Character.HumanoidRootPart.Position or Vector3.new(0, 0, 0)

	

	local distance = (currentTarget.Position - playerPosition).Magnitude

	if distance > LOCK_ON_RANGE or not isTargetVisible(currentTarget) then

		currentTarget = findBestTarget()

		if not currentTarget then return end

	end

	

	-- Smoothly lerp camera to look at target

	local currentCFrame = camera.CFrame

	local targetPosition = currentTarget.Position

	local lookVector = (targetPosition - currentCFrame.Position).Unit

	

	-- Create new CFrame looking at target, maintaining current camera distance

	local newCFrame = CFrame.new(currentCFrame.Position, 

		currentCFrame.Position + lookVector)

	

	camera.CFrame = currentCFrame:Lerp(newCFrame, LOCK_SMOOTHNESS)

end

-- Input handling for PC

local function setupPCControls()

	UserInputService.InputBegan:Connect(function(input, processed)

		if processed then return end

		

		if input.KeyCode == Enum.KeyCode.Q then

			isLockedOn = not isLockedOn

			if not isLockedOn then

				currentTarget = nil

			end

		end

	end)

	

	-- Target cycling with E and Q

	UserInputService.InputBegan:Connect(function(input, processed)

		if not isLockedOn or processed then return end

		

		if input.KeyCode == Enum.KeyCode.E then

			-- Find all valid targets

			local targets = {}

			local playerPosition = player.Character and player.Character:FindFirstChild("HumanoidRootPart") 

				and player.Character.HumanoidRootPart.Position or Vector3.new(0, 0, 0)

			

			for _, otherPlayer in ipairs(Players:GetPlayers()) do

				if otherPlayer ~= player and otherPlayer.Character then

					local head = otherPlayer.Character:FindFirstChild("Head")

					local humanoid = otherPlayer.Character:FindFirstChild("Humanoid")

					

					if head and humanoid and humanoid.Health > 0 then

						local distance = (head.Position - playerPosition).Magnitude

						if distance <= LOCK_ON_RANGE and isTargetVisible(head) then

							table.insert(targets, head)

						end

					end

				end

			end

			

			if #targets > 0 then

				-- Cycle to next target

				local foundCurrent = false

				local nextTarget = nil

				

				for i, target in ipairs(targets) do

					if currentTarget == target then

						foundCurrent = true

						nextTarget = targets[(i % #targets) + 1]

						break

					end

				end

				

				if not foundCurrent then

					nextTarget = targets[1]

				end

				

				currentTarget = nextTarget

			end

		end

	end)

end

-- Create indicator for current target

local function createTargetIndicator()

	local indicator = Instance.new("BillboardGui")

	indicator.Name = "TargetIndicator"

	indicator.Size = UDim2.new(4, 0, 4, 0)

	indicator.AlwaysOnTop = true

	indicator.Enabled = false

	

	local frame = Instance.new("Frame")

	frame.Size = UDim2.new(1, 0, 1, 0)

	frame.BackgroundColor3 = Color3.fromRGB(255, 50, 50)

	frame.BackgroundTransparency = 0.5

	frame.BorderSizePixel = 0

	frame.Parent = indicator

	

	return indicator

end

-- Main update loop

local function startUpdateLoop()

	local targetIndicator = createTargetIndicator()

	

	RunService.RenderStepped:Connect(function()

		if isLockedOn then

			updateCameraLock()

			

			-- Update target indicator

			if currentTarget and currentTarget.Parent then

				if not targetIndicator.Parent then

					targetIndicator.Parent = currentTarget

				elseif targetIndicator.Parent ~= currentTarget then

					targetIndicator.Parent = currentTarget

				end

				targetIndicator.Enabled = true

			else

				targetIndicator.Enabled = false

			end

		else

			targetIndicator.Enabled = false

		end

	end)

end

-- Initialize

local function init()

	-- Wait for player to load

	repeat

		wait()

	until player.Character and player.Character:FindFirstChild("Humanoid")

	

	-- Create UI

	createMobileUI()

	

	-- Setup controls

	setupPCControls()

	

	-- Start update loop

	startUpdateLoop()

	

	-- Instructions

	print("Camera Lock-On System Loaded!")

	print("PC Controls:")

	print("  - Press Q to toggle lock-on")

	print("  - Press E to cycle targets when locked on")

	print("Mobile: Use the lock-on button on screen")

end

-- Character added/removed handling

player.CharacterAdded:Connect(init)

if player.Character then

	init()

end

end})

