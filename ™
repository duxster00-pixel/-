-- Coloque este LocalScript em StarterPlayerScripts ou StarterGui

local Players = game:GetService("Players")

local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- Configurações

local ESP_COLOR = Color3.fromRGB(0, 255, 0)  -- Cor verde

local LINE_THICKNESS = 1

local UPDATE_INTERVAL = 0.1  -- Atualiza a cada 0.1 segundos

-- Armazenamento

local espLines = {}  -- [player] = line

local espConnections = {}  -- Conexões para cleanup

-- Função para criar uma linha ESP

local function createLine(player)

    if espLines[player] then return end

    

    local line = Drawing.new("Line")

    line.Visible = false

    line.Color = ESP_COLOR

    line.Thickness = LINE_THICKNESS

    line.ZIndex = 1

    

    espLines[player] = line

    

    -- Conectar para remover quando o player sair

    local connection = player:GetPropertyChangedSignal("Parent"):Connect(function()

        if not player.Parent then

            cleanupPlayer(player)

        end

    end)

    table.insert(espConnections, connection)

end

-- Função para remover ESP de um player

local function cleanupPlayer(player)

    if espLines[player] then

        espLines[player]:Remove()

        espLines[player] = nil

    end

    

    -- Remover conexões associadas

    for i, conn in ipairs(espConnections) do

        if not conn.Connected then

            table.remove(espConnections, i)

            break

        end

    end

end

-- Função para atualizar todas as linhas

local function updateESP()

    local camera = workspace.CurrentCamera

    if not camera then return end

    

    local localChar = LocalPlayer.Character

    if not localChar then return end

    

    local localRoot = localChar:FindFirstChild("HumanoidRootPart")

    if not localRoot then return end

    

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer and player.Character then

            local char = player.Character

            local humanoid = char:FindFirstChild("Humanoid")

            local rootPart = char:FindFirstChild("HumanoidRootPart")

            

            -- Criar linha se não existir

            if not espLines[player] then

                createLine(player)

            end

            

            local line = espLines[player]

            

            -- Verificar se o player está morto

            if humanoid and humanoid.Health <= 0 then

                line.Visible = false

                cleanupPlayer(player)

            elseif rootPart then

                -- Calcular posições na tela

                local rootPos, rootVisible = camera:WorldToViewportPoint(rootPart.Position)

                local localPos, localVisible = camera:WorldToViewportPoint(localRoot.Position)

                

                -- Mostrar/ocultar baseado na visibilidade

                if rootVisible and localVisible then

                    line.From = Vector2.new(localPos.X, localPos.Y)

                    line.To = Vector2.new(rootPos.X, rootPos.Y)

                    line.Visible = true

                else

                    line.Visible = false

                end

            else

                line.Visible = false

            end

        elseif espLines[player] then

            -- Player sem personagem ou morto

            espLines[player].Visible = false

            cleanupPlayer(player)

        end

    end

end

-- Gerenciar players entrando/saindo

local function playerAdded(player)

    if player ~= LocalPlayer then

        createLine(player)

        

        -- Conectar morte do player

        local conn

        conn = player.CharacterAdded:Connect(function(char)

            task.wait(0.5)  -- Esperar personagem carregar

            if espLines[player] then

                espLines[player].Visible = true

            end

        end)

        table.insert(espConnections, conn)

        

        -- Conectar quando personagem for removido

        local conn2 = player.CharacterRemoving:Connect(function()

            if espLines[player] then

                espLines[player].Visible = false

            end

        end)

        table.insert(espConnections, conn2)

    end

end

local function playerRemoving(player)

    cleanupPlayer(player)

end

-- Inicializar para players existentes

for _, player in ipairs(Players:GetPlayers()) do

    playerAdded(player)

end

-- Conectar eventos

Players.PlayerAdded:Connect(playerAdded)

Players.PlayerRemoving:Connect(playerRemoving)

-- Loop de atualização

local updateConnection

updateConnection = RunService.RenderStepped:Connect(function(deltaTime)

    pcall(updateESP)  -- Usar pcall para evitar erros

end)

-- Cleanup quando o script for destruído

local function cleanup()

    if updateConnection then

        updateConnection:Disconnect()

    end

    

    for _, conn in ipairs(espConnections) do

        conn:Disconnect()

    end

    

    for player, line in pairs(espLines) do

        line:Remove()

    end

    

    espLines = {}

    espConnections = {}

end

-- Conectar para cleanup

script.Destroying:Connect(cleanup)

LocalPlayer.CharacterRemoving:Connect(cleanup)

end})
