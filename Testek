--// TOGGLE UI
local function ToggleUI(state)
	Main.Visible = true
	TweenService:Create(Main, TweenInfo.new(0.35), {
		Size = state and UDim2.new(0,520,0,360) or UDim2.new(0,0,0,0)
	}):Play()

	TweenService:Create(Blur, TweenInfo.new(0.35), {
		Size = state and 18 or 0
	}):Play()

	task.wait(0.35)
	Main.Visible = state
end

OpenButton.MouseButton1Click:Connect(function()
	ToggleUI(not Main.Visible)
end)

